# Build / IDE
build/
.gradle/
out/
run/
*.class
*.log
.idea/
*.iml
.vscode/

# Local working area used for the 1:1 audit of the original plugin.
# The authoritative inputs are the four archives committed at the repo root.
# Nothing under audit/ is committed: it holds extracted plugin sources plus the
# Mojang-mapped Minecraft reference sources fetched by tools/fetch_mc.py, both of
# which are third-party material that must not be redistributed from this repo.
audit/

# Python helper venv (JDK used by the audit tooling)
.venv-jdk/

# Release staging (regenerated by tools/make_release.py)
dist/staging/
__pycache__/
