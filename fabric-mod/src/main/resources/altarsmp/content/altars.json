    },
    "sounds": [
     {
      "sound": "UI_TOAST_CHALLENGE_COMPLETE",
      "volume": 1.0,
      "pitch": 0.8,
      "to": "self"
     },
     {
      "sound": "ENTITY_WARDEN_SONIC_BOOM",
      "volume": 0.8,
      "pitch": 0.3,
      "to": "all"
     },
     {
      "sound": "ENTITY_WARDEN_ROAR",
      "volume": 0.6,
      "pitch": 0.5,
      "to": "all"
     },
     {
      "sound": "BLOCK_END_PORTAL_SPAWN",
      "volume": 0.5,
      "pitch": 0.5,
      "to": "all"
     }
    ],
    "messages": [
     {
      "var": "var11",
      "to": "self",
      "color": "red",
      "text": "Missing items to craft Contagion Signal:"
     },
     {
      "var": "var11",
      "to": "self",
      "raw": "var14"
     },
     {
      "var": "var11",
      "to": "self",
      "color": "gray",
      "text": "(Items will NOT be consumed)"
     },
     {
      "var": "var10",
      "to": "all",
      "raw": "\"<gold>\" + var11.getName() + \" <yellow>has crafted the <green>Contagion Signal<yellow>!\""
     },
     {
      "var": "var11",
      "to": "self",
      "blank": true
     },
     {
      "var": "var11",
      "to": "self",
      "markup": "<dark_gray>The three powers have combined..."
     },
     {
      "var": "var11",
      "to": "self",
      "markup": "<gradient:#FF0000:#808080:#FFFFFF>You now hold the Contagion Signal.</gradient>"
     },
     {
      "var": "var11",
      "to": "self",
      "markup": "<gray>Place it on a Stripped Warped Hyphae block to begin the ritual."
     },
     {
      "var": "var11",
      "to": "self",
      "blank": true
     }
    ],
    "removes_altar": true,
    "special": "contagionsignal"
   },
   "ingredients": {
    "custom_pale_crossbow": 1,
    "custom_hyperion": 1,
    "custom_nightpiercer": 1
   }
