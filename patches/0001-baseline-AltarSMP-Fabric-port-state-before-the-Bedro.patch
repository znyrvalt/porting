+					if (!(entity instanceof LivingEntity living) || living == caster) {
+						continue;
+					}
+					if (living instanceof ServerPlayer other && !allowed(caster, other)) {
+						continue;
+					}
+					if (!struck.add(living.getUUID())) {
+						continue;
+					}
