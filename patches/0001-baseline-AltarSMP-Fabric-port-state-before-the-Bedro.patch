+		BlockState ground = level.getBlockState(base.below());
+		if (!ground.blocksMotion() || !ground.getFluidState().isEmpty()) {
+			return null;
+		}
+		return base;
+	}
+
+	/**
+	 * Raises one pillar at {@code base} and puts its altar on the deck.
