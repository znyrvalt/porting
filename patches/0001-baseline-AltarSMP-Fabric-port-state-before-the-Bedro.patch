+S2_SUPER = re.compile(
+    r'super\(\s*var\d+\s*,\s*"((?:[^"\\]|\\.)*)"\s*,\s*"([a-z0-9_]+)"\s*,\s*ChatColor\.([A-Z_]+)\s*,\s*'
+    r'([A-Za-z0-9_]+)::create\s*\)')
