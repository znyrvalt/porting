+			case "illusioncore" -> buildIllusionCorePillar(level, base, pillar, rand);
+			case "weaponhandle" -> buildWeaponHandlePillar(level, base, pillar, rand);
+			default -> buildPlainPillar(level, base, pillar, rand);
