+	}
+
+	/** {@code HotPotatoEvent#start}. */
+	public void start() {
+		if (this.running) {
+			return;
+		}
+		MinecraftServer server = this.mod.server();
+		if (server == null) {
+			return;
+		}
+		this.running = true;
+		this.endsAt = System.currentTimeMillis() + DURATION_MILLIS;
+		this.holdTimes.clear();
+		this.holdStarts.clear();
+		this.holder = null;
+		this.lastAnnounce = 0L;
