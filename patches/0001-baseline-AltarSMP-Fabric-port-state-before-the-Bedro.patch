+	public void particles(String bukkitParticle, Vec3 pos, int count, double dx, double dy, double dz, double speed) {
+		ParticleType<?> type = com.altarsmp.fabric.util.GameRegistry.particle(bukkitParticle);
+		if (type == null) {
