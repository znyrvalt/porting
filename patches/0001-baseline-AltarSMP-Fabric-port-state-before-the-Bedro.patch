+				activateStormcall(owner, level, next, durationSeconds, damage, hitInterval, maxTargets, cloudHeight);
+			}
+		}, 0L, 1L).cancelAfter((long) Math.ceil(TRIDENT_MAX_DISTANCE / TRIDENT_SPEED) + 10L);
+	}
