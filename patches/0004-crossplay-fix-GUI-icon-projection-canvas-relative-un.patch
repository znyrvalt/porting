+    scale = drawable / CANVAS_UNITS
+    span = max(max(xs) - min(xs), max(ys) - min(ys))
+    if span * scale > drawable:
+        # auto-fit: uniform scale-to-fit, preserving aspect
+        scale = drawable / span
     out = []
